---
import '../styles/moon-hero.css';
import { withBase } from '../utils/withBase';
---

<div class="moon-hero-root">
  <video
    class="moon-hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={withBase('/images/moon-hero.jpg')}
    aria-label="Moon-landing themed footage with astronaut activity on the lunar surface"
  >
    <source src={withBase('/videos/moon-hero.mp4')} type="video/mp4" />
  </video>
  <div class="moon-hero-scrim" aria-hidden="true"></div>
  <div class="moon-hero-cool" aria-hidden="true"></div>
  <div class="moon-hero-vignette" aria-hidden="true"></div>
</div>
