---
import '../styles/control-room-hero.css';
import { withBase } from '../utils/withBase';
---

<div class="control-room-hero-root">
  <video
    class="control-room-hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={withBase('/images/control-room-hero.jpg')}
    aria-label="Operators working at mission-control style consoles and displays"
  >
    <source src={withBase('/videos/control-room-hero.mp4')} type="video/mp4" />
  </video>
  <div class="control-room-hero-scrim" aria-hidden="true"></div>
  <div class="control-room-hero-cool" aria-hidden="true"></div>
  <div class="control-room-hero-vignette" aria-hidden="true"></div>
</div>
