---
import type { TimelineEvent } from '../data/timelines';

interface Props {
  events: TimelineEvent[];
}
const { events } = Astro.props;
---

<div class="relative">
  <div
    class="absolute bottom-0 left-[0.6rem] top-2 w-px bg-gradient-to-b from-nebula/50 via-white/10 to-transparent md:left-3"
    aria-hidden="true"
  >
  </div>
  <ul class="space-y-10 md:space-y-12">
    {
      events.map((e) => (
        <li class="relative flex gap-6 md:gap-10">
          <div class="relative z-10 flex h-6 w-6 shrink-0 items-center justify-center md:h-7 md:w-7">
            <span class="h-2.5 w-2.5 rounded-full bg-nebula shadow-[0_0_12px_rgba(110,181,255,0.6)] md:h-3 md:w-3" />
          </div>
          <div class="pb-2">
            <p class="font-mono text-sm text-nebula-dim">{e.year}</p>
            <h3 class="mt-1 font-display text-lg font-semibold text-white">{e.title}</h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-400">{e.detail}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
