---
import '../styles/mars-hero.css';
import { withBase } from '../utils/withBase';
---

<div class="mars-hero-root">
  <video
    class="mars-hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={withBase('/images/mars-hero.jpg')}
    aria-label="Astronauts and robotic exploration visuals on a Mars-like landscape"
  >
    <source src={withBase('/videos/mars-hero.mp4')} type="video/mp4" />
  </video>
  <div class="mars-hero-scrim" aria-hidden="true"></div>
  <div class="mars-hero-warm" aria-hidden="true"></div>
  <div class="mars-hero-vignette" aria-hidden="true"></div>
</div>
