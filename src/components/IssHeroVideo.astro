---
import '../styles/iss-hero.css';
import { withBase } from '../utils/withBase';
---

<div class="iss-hero-root">
  <video
    class="iss-hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={withBase('/images/iss-hero.jpg')}
    aria-label="International Space Station orbiting above Earth"
  >
    <source src={withBase('/videos/iss-hero.mp4')} type="video/mp4" />
  </video>
  <div class="iss-hero-scrim" aria-hidden="true"></div>
  <div class="iss-hero-cool" aria-hidden="true"></div>
  <div class="iss-hero-vignette" aria-hidden="true"></div>
</div>
