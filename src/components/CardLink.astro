---
import { withBase } from '../utils/withBase';

interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
}
const { href, title, description, meta } = Astro.props;
---

<a href={withBase(href)} class="card-link group">
  <div class="card-link-glow"></div>
  {meta && <p class="mb-2 text-xs font-medium uppercase tracking-wider text-nebula-dim">{meta}</p>}
  <h2 class="card-link-title">{title}</h2>
  <p class="mt-2 text-sm leading-relaxed text-slate-400">{description}</p>
  <span class="card-link-cta">
    Explore
    <span aria-hidden="true">→</span>
  </span>
</a>
