---
import '../styles/jobs-hero.css';
import { withBase } from '../utils/withBase';
---

<div class="jobs-hero-root">
  <video
    class="jobs-hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={withBase('/images/jobs-hero.jpg')}
    aria-label="Engineering and coding work that represents technical careers in space programs"
  >
    <source src={withBase('/videos/jobs-hero.mp4')} type="video/mp4" />
  </video>
  <div class="jobs-hero-scrim" aria-hidden="true"></div>
  <div class="jobs-hero-cool" aria-hidden="true"></div>
  <div class="jobs-hero-vignette" aria-hidden="true"></div>
</div>
