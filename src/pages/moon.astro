---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MoonHeroVideo from '../components/MoonHeroVideo.astro';
import Timeline from '../components/Timeline.astro';
import { moonExplorationTimeline, apolloLandings } from '../data/timelines';
---

<Layout
  title="Moon landings"
  description="Apollo and lunar exploration — timeline, the six Moon landings, and context before and after."
>
  <section class="page-home-hero">
    <MoonHeroVideo />
    <div class="page-home-hero-inner">
      <p class="page-home-hero-eyebrow">Lunar history</p>
      <h1 class="page-home-hero-heading">The Moon and Apollo</h1>
      <p class="page-home-hero-lead">
        From first steps to long-term return plans, the Moon remains the proving ground for deep-space operations.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 pb-24 md:px-8">
    <PageHero
      eyebrow="Mission context"
      title="How the moon-landing era unfolded"
      subtitle="From robotic scouts to bootprints in the regolith—how humanity reached the Moon, what we did there, and why the story still matters."
    />

    <section class="mb-20">
      <h2 class="font-display text-2xl font-semibold text-white">Timeline</h2>
      <p class="mt-3 max-w-2xl text-slate-400">
        A condensed chronology emphasizing engineering milestones and the Apollo surface era.
      </p>
      <div class="mt-10">
        <Timeline events={moonExplorationTimeline} />
      </div>
    </section>

    <section>
      <h2 class="font-display text-2xl font-semibold text-white">Apollo lunar landings</h2>
      <p class="mt-3 max-w-2xl text-slate-400">
        Six missions landed twelve astronauts on the Moon between 1969 and 1972. Apollo 13 flew a free-return trajectory
        after an onboard emergency and did not land.
      </p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-b border-white/10 bg-void-850/80">
            <tr>
              <th class="px-4 py-3 font-medium text-slate-300">Mission</th>
              <th class="px-4 py-3 font-medium text-slate-300">Landing site</th>
              <th class="px-4 py-3 font-medium text-slate-300">Date (UTC context)</th>
              <th class="px-4 py-3 font-medium text-slate-300">Crew</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {
              apolloLandings.map((row) => (
                <tr class="transition hover:bg-white/[0.03]">
                  <td class="px-4 py-3 font-mono text-nebula-dim">{row.mission}</td>
                  <td class="px-4 py-3 text-slate-300">{row.site}</td>
                  <td class="px-4 py-3 text-slate-400">{row.date}</td>
                  <td class="px-4 py-3 text-slate-400">{row.crew}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
