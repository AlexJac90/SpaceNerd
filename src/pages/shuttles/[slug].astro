---
import Layout from '../../layouts/Layout.astro';
import { orbiters, getOrbiter } from '../../data/shuttles';
import { withBase } from '../../utils/withBase';

export function getStaticPaths() {
  return orbiters.map((o) => ({ params: { slug: o.slug } }));
}

const { slug } = Astro.params;
const orbiter = getOrbiter(slug!);

if (!orbiter) {
  return Astro.redirect(withBase('/shuttles'));
}
---

<Layout
  title={orbiter.name}
  description={`${orbiter.name}: ${orbiter.tagline}. Space Shuttle orbiter overview on Space Nerd.`}
>
  <div class="mx-auto max-w-6xl px-5 pb-24 md:px-8">
    <nav class="pt-8 text-sm text-slate-500">
      <a href={withBase('/shuttles')} class="text-nebula hover:underline">&larr; Shuttles</a>
    </nav>

    <header class="mt-8 border-b border-white/10 pb-10">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-nebula-dim">Orbiter</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-white md:text-5xl">{orbiter.name}</h1>
      <p class="mt-3 text-lg text-slate-400">{orbiter.tagline}</p>
      <figure class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-void-900/60">
        <img src={orbiter.imageSrc} alt={orbiter.imageAlt} class="h-64 w-full object-cover object-center md:h-80" />
        <figcaption class="px-4 py-3 text-xs text-slate-500">
          Photo:
          <a href={orbiter.imageCreditUrl} class="ml-1 text-slate-400 underline-offset-2 hover:underline">
            {orbiter.imageCredit}
          </a>
        </figcaption>
      </figure>
      <dl class="mt-8 flex flex-wrap gap-6 font-mono text-sm text-slate-500">
        <div>
          <dt class="text-slate-600">First flight</dt>
          <dd class="mt-1 text-slate-300">{orbiter.firstFlight}</dd>
        </div>
        <div>
          <dt class="text-slate-600">Last flight</dt>
          <dd class="mt-1 text-slate-300">{orbiter.lastFlight}</dd>
        </div>
        <div>
          <dt class="text-slate-600">Missions</dt>
          <dd class="mt-1 text-slate-300">{orbiter.missions}</dd>
        </div>
      </dl>
    </header>

    <div class="prose prose-invert prose-lg mt-10 max-w-none">
      <p class="text-lg leading-relaxed text-slate-300">{orbiter.summary}</p>
    </div>

    <section class="mt-12">
      <h2 class="font-display text-xl font-semibold text-white">Highlights</h2>
      <ul class="mt-4 space-y-3 text-slate-400">
        {orbiter.highlights.map((h) => <li class="flex gap-3"><span class="text-nebula">·</span>{h}</li>)}
      </ul>
    </section>

    <section
      class:list={[
        'mt-12 rounded-2xl border p-6 md:p-8',
        orbiter.status === 'lost' ? 'border-red-500/20 bg-red-950/20' : 'border-white/10 bg-void-850/40',
      ]}
    >
      <h2 class="font-display text-lg font-semibold text-white">Status</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-400">{orbiter.statusNote}</p>
    </section>
  </div>
</Layout>
