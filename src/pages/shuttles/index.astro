---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { orbiters } from '../../data/shuttles';
import { withBase } from '../../utils/withBase';
---

<Layout
  title="Space Shuttles"
  description="NASA’s Space Shuttle orbiters: Columbia, Challenger, Discovery, Atlantis, and Endeavour."
>
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <PageHero
      eyebrow="NASA STS"
      title="The orbiter fleet"
      subtitle="Five winged spacecraft flew 135 missions between 1981 and 2011—building a space station, launching great observatories, and rewriting what reusable vehicles could do."
    />

    <div class="grid gap-5 pb-20 sm:grid-cols-2 lg:grid-cols-3">
      {
        orbiters.map((o) => (
          <a
            href={withBase(`/shuttles/${o.slug}`)}
            class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-void-850/50 transition hover:border-nebula/35 hover:bg-void-800/70"
          >
            <img src={o.imageSrc} alt={o.imageAlt} class="h-44 w-full object-cover object-center" loading="lazy" />
            <div class="flex h-full flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-display text-xl font-semibold text-white group-hover:text-nebula-glow">
                  {o.name}
                </h2>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
                    o.status === 'lost' ? 'bg-red-500/15 text-red-300' : 'bg-emerald-500/15 text-emerald-300',
                  ]}
                >
                  {o.status === 'lost' ? 'Memorial' : 'Retired'}
                </span>
              </div>
              <p class="mt-2 text-sm text-nebula-dim">{o.tagline}</p>
              <p class="shuttle-card-summary mt-4 flex-1 text-sm leading-relaxed text-slate-400">{o.summary}</p>
              <p class="mt-4 font-mono text-xs text-slate-500">
                {o.firstFlight} — {o.lastFlight}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <section class="border-t border-white/10 pb-24">
      <h2 class="font-display text-xl font-semibold text-white">Program arc</h2>
      <p class="mt-3 max-w-2xl text-slate-400">
        For a chronological view—from approval through triumph and tragedy to retirement—visit the{' '}
        <a href={withBase('/shuttles/timeline')} class="text-nebula underline-offset-4 hover:underline">shuttle timeline</a>.
      </p>
    </section>
  </div>
</Layout>

<style>
  .shuttle-card-summary {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
