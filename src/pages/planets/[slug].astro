---
import Layout from '../../layouts/Layout.astro';
import { planets, getPlanet } from '../../data/planets';
import { withBase } from '../../utils/withBase';

export function getStaticPaths() {
  return planets.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const planet = getPlanet(slug!);

if (!planet) {
  return Astro.redirect(withBase('/planets'));
}
---

<Layout
  title={planet.name}
  description={`${planet.name}: ${planet.type}. Quick facts and overview on Space Nerd.`}
>
  <div class="mx-auto max-w-6xl px-5 pb-24 md:px-8">
    <nav class="pt-8 text-sm text-slate-500">
      <a href={withBase('/planets')} class="text-nebula hover:underline">&larr; Planets</a>
    </nav>

    <header class="mt-8">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-nebula-dim">{planet.type}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-white md:text-5xl">{planet.name}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-400">{planet.blurb}</p>
    </header>

    <dl
      class="mt-12 grid gap-6 rounded-2xl border border-white/10 bg-void-850/40 p-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Avg. distance</dt>
        <dd class="mt-1 font-mono text-slate-200">{planet.orbitAU}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Diameter</dt>
        <dd class="mt-1 font-mono text-slate-200">{planet.diameterKm}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Day length</dt>
        <dd class="mt-1 text-slate-200">{planet.dayLength}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Year length</dt>
        <dd class="mt-1 text-slate-200">{planet.yearLength}</dd>
      </div>
      <div class="sm:col-span-2 lg:col-span-3">
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Moons</dt>
        <dd class="mt-1 text-slate-200">{planet.moons}</dd>
      </div>
    </dl>

    <section class="mt-12 rounded-2xl border border-nebula/20 bg-nebula/5 p-6 md:p-8">
      <h2 class="font-display text-lg font-semibold text-white">Did you know?</h2>
      <p class="mt-3 text-slate-300">{planet.fact}</p>
    </section>

    {
      planet.slug === 'mars' && (
        <section class="mt-10 rounded-2xl border border-white/10 bg-void-850/40 p-6 md:p-8">
          <h2 class="font-display text-lg font-semibold text-white">Mars mission planning</h2>
          <p class="mt-3 text-slate-300">
            For a dedicated overview of Mars plus a practical summary of SpaceX&apos;s public Starship-to-Mars plan,
            visit{' '}
            <a href={withBase('/mars')} class="text-nebula hover:underline">
              /mars
            </a>
            .
          </p>
        </section>
      )
    }

  </div>
</Layout>
